; LANES -- space traffic management. See LANES_MVP.md for the spec.

config_version=5

[application]

config/name="LANES"
run/main_scene="res://scenes/TitleScreen.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")

[autoload]

Events="*res://scripts/autoload/Events.gd"
Game="*res://scripts/autoload/Game.gd"
TechManager="*res://scripts/autoload/TechManager.gd"
Dispatcher="*res://scripts/autoload/Dispatcher.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

